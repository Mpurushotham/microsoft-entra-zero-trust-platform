{
  "@odata.type": "#microsoft.graph.depIOSEnrollmentProfile",
  "displayName": ${jsonencode(display_name)},
  "description": "Supervised, user-affinity ADE enrollment authenticated in Setup Assistant (modern authentication).",
  "requiresUserAuthentication": true,
  "enableAuthenticationViaCompanyPortal": false,
  "requireCompanyPortalOnSetupAssistantEnrolledDevices": true,
  "supervisedModeEnabled": true,
  "isMandatory": true,
  "profileRemovalDisabled": true,
  "awaitDeviceConfiguredConfirmation": true,
  "supportDepartment": ${jsonencode(support_department)},
  "supportPhoneNumber": ${jsonencode(support_phone_number)},
  "locationDisabled": false,
  "restoreBlocked": true,
  "appleIdDisabled": true,
  "termsAndConditionsDisabled": true,
  "touchIdDisabled": false,
  "applePayDisabled": true,
  "siriDisabled": true,
  "diagnosticsDisabled": true,
  "screenTimeScreenDisabled": true,
  "iMessageAndFaceTimeScreenDisabled": true,
  "passCodeDisabled": false
}
