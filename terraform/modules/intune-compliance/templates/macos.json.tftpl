{
  "@odata.type": "#microsoft.graph.macOSCompliancePolicy",
  "displayName": ${jsonencode(display_name)},
  "description": "macOS passcode, FileVault, SIP, firewall and Gatekeeper posture.",
  "roleScopeTagIds": ${jsonencode(role_scope_tag_ids)},
  "osMinimumVersion": ${jsonencode(os_minimum_version)},
  "passwordRequired": true,
  "passwordBlockSimple": true,
  "passwordMinimumLength": 8,
  "passwordMinutesOfInactivityBeforeLock": 15,
  "systemIntegrityProtectionEnabled": true,
  "storageRequireEncryption": true,
  "firewallEnabled": true,
  "gatekeeperAllowedAppSource": "macAppStoreAndIdentifiedDevelopers",
  "deviceThreatProtectionEnabled": ${threat_enabled},
  "deviceThreatProtectionRequiredSecurityLevel": ${jsonencode(threat_enabled ? threat_level : "unavailable")},
  "scheduledActionsForRule": [
    {
      "ruleName": "PasswordRequired",
      "scheduledActionConfigurations": [
        {
          "actionType": "block",
          "gracePeriodHours": ${grace_period_hours},
          "notificationTemplateId": "",
          "notificationMessageCCList": []
        }
      ]
    }
  ]
}
