{
  "@odata.type": "#microsoft.graph.androidManagedAppProtection",
  "displayName": ${jsonencode(display_name)},
  "description": ${jsonencode("Microsoft App protection framework level ${level_number} for Android.")},
  "roleScopeTagIds": ${jsonencode(role_scope_tag_ids)},
  "periodOfflineBeforeAccessCheck": ${jsonencode(offline_access_check)},
  "periodOnlineBeforeAccessCheck": ${jsonencode(online_access_check)},
  "periodOfflineBeforeWipeIsEnforced": ${jsonencode(offline_wipe)},
  "dataBackupBlocked": ${backup_blocked},
  "allowedInboundDataTransferSources": ${jsonencode(inbound_sources)},
  "allowedOutboundDataTransferDestinations": ${jsonencode(outbound_destinations)},
  "allowedOutboundClipboardSharingLevel": ${jsonencode(clipboard_level)},
  "saveAsBlocked": ${save_as_blocked},
  "allowedDataStorageLocations": ${jsonencode(storage_locations)},
  "printBlocked": ${print_blocked},
  "contactSyncBlocked": false,
  "organizationalCredentialsRequired": false,
  "managedBrowserToOpenLinksRequired": ${managed_browser_required},
  "managedBrowser": ${jsonencode(managed_browser)},
  "notificationRestriction": ${jsonencode(notification_restriction)},
  "screenCaptureBlocked": ${screen_capture_blocked},
  "encryptAppData": true,
  "disableAppEncryptionIfDeviceEncryptionIsEnabled": false,
  "pinRequired": true,
  "pinCharacterSet": "numeric",
  "minimumPinLength": ${pin_min_length},
  "simplePinBlocked": ${simple_pin_blocked},
  "maximumPinRetries": 5,
  "appActionIfMaximumPinRetriesExceeded": "block",
  "previousPinBlockCount": 0,
  "fingerprintBlocked": false,
  "disableAppPinIfDevicePinIsSet": ${app_pin_off_with_device_pin},
  "pinRequiredInsteadOfBiometricTimeout": "PT30M",
  "deviceComplianceRequired": true,
  "appActionIfDeviceComplianceRequired": "block",
  "minimumRequiredOsVersion": ${jsonencode(minimum_os_version)},
  "maximumAllowedDeviceThreatLevel": ${jsonencode(max_device_threat_level)},
  "mobileThreatDefenseRemediationAction": "block"
}
